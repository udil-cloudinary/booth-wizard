# Booth Cloudinary cloud. Only the cloud name and an UNSIGNED preset name. Never an API key or secret.
VITE_CLOUD_NAME=your-booth-cloud
VITE_UPLOAD_PRESET=booth_wizard
VITE_ASSET_FOLDER=booth/visitors

# metadata = structured metadata (default); context = fallback if the cloud refuses metadata on unsigned uploads
VITE_META_MODE=metadata

# true = no network; fake response with one face, for demos without the booth cloud
VITE_MOCK_UPLOAD=false

# Face model. Default is Google's hosted model. To self-host, run `npm run fetch-model`
# and set this to mediapipe/blaze_face_short_range.tflite
VITE_FACE_MODEL_URL=
