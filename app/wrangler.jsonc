// Cloudflare deploy: a Worker that only serves the static build (dist/), no server code.
// `npm run deploy` checks the env, builds, then uploads. The first deploy creates the
// `booth-wizard` Worker on the account and attaches the QR domain below.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "booth-wizard",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist"
  },
  // The QR code points here. Cloudflare creates the DNS record and certificate on deploy;
  // the cloudinary.app zone must be on the same account. workers.dev stays on for preview URLs.
  "routes": [{ "pattern": "everywhere.cloudinary.app", "custom_domain": true }],
  "workers_dev": true
}
