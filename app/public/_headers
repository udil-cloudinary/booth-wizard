# Cloudflare static assets cache rules (copied to dist/ by Vite).
# Hashed file names never change content, so they cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The MediaPipe runtime only changes with a package update.
/mediapipe/*
  Cache-Control: public, max-age=604800

# The page itself always revalidates, so a deploy reaches phones at once.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
